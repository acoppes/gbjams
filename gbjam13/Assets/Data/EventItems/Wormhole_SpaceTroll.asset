MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5139c9d6f004936b4b61d38336512fb, type: 3}
  m_Name: Wormhole_SpaceTroll
  m_EditorClassIdentifier: Assembly-CSharp::GBJAM13.Data.EventElementData
  type: {fileID: 11400000, guid: 6236d74cbd260e84e9ce7d46995e2aed, type: 2}
  description: It seems we found a way to escape the galaxy but the Space Troll is
    asking us luckies tax
  options:
  - description: Pay luckies and see if we can leave the galaxy safe
    resourceType: {fileID: 11400000, guid: 4ca3a9fc733f2bd4ab8ad3113fd921a0, type: 2}
    numberRange:
      Min: -5
      Max: -10
    outcomes:
    - description: The Troll was smarter than we thought and he ate the crew
      resourceType: {fileID: 11400000, guid: a27cfb7a6001b75429489818cba3134c, type: 2}
      numberRange:
        Min: -4
        Max: -6
    - description: The Troll accepted..... but the wormhole is cursed.
      resourceType: {fileID: 11400000, guid: 4ca3a9fc733f2bd4ab8ad3113fd921a0, type: 2}
      numberRange:
        Min: 0
        Max: -5
  - description: Fire torpedoes at the Space Troll and escape fast.
    resourceType: {fileID: 11400000, guid: 4acce0b1fb1dfe24aabfca033c94a093, type: 2}
    numberRange:
      Min: 4
      Max: 8
    outcomes:
    - description: The Space Troll had a planetary shield, he is angry but we escaped.
      resourceType: {fileID: 11400000, guid: 4ca3a9fc733f2bd4ab8ad3113fd921a0, type: 2}
      numberRange:
        Min: -4
        Max: -8
    - description: We managed to escape safe while the Space Troll was blinded by
        the torpedoes.
      resourceType: {fileID: 11400000, guid: 418bdd25dc271684689ae1a6a6730d50, type: 2}
      numberRange:
        Min: 4
        Max: 8
  - description: Propose a riddle and if he fails we can pass without paying.
    resourceType: {fileID: 11400000, guid: 418bdd25dc271684689ae1a6a6730d50, type: 2}
    numberRange:
      Min: -1
      Max: -5
    outcomes:
    - description: It took some time but he managed to solve it, now we had to pay
        double.
      resourceType: {fileID: 11400000, guid: 4ca3a9fc733f2bd4ab8ad3113fd921a0, type: 2}
      numberRange:
        Min: -5
        Max: -10
    - description: While he was distracted solving the riddle, we activated invisibility
        and escaped.
      resourceType: {fileID: 11400000, guid: 4acce0b1fb1dfe24aabfca033c94a093, type: 2}
      numberRange:
        Min: -5
        Max: -10
    - description: The Space Troll failed to solve the riddle, he paid us and we
        escaped.
      resourceType: {fileID: 11400000, guid: 4ca3a9fc733f2bd4ab8ad3113fd921a0, type: 2}
      numberRange:
        Min: 5
        Max: 10
